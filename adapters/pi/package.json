{
  "name": "@kepler/pi",
  "version": "0.0.0",
  "private": true,
  "description": "Pi Coding Agent adapter for Kepler: automatic hooks over local IPC (not verified against a live Pi session)",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "kepler",
    "agent"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "extensions/",
    "src/",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/*.test.ts\""
  },
  "pi": {
    "extensions": [
      "./extensions/kepler.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mreyeswilson/kepler.git",
    "directory": "adapters/pi"
  }
}
